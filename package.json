    "predesktop:build": "node scripts/check-toolchain.mjs && node scripts/version.mjs --auto && node scripts/version.mjs --check",
    "setup": "node scripts/setup.mjs",
    "setup:plan": "node scripts/setup.mjs --plan",
    "setup:test": "node --test scripts/test-setup.mjs",
    "version:bump": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:sync": "node scripts/version.mjs --sync",
    "version:test": "node --test scripts/test-version.mjs"
