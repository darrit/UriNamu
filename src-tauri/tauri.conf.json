{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UriNamu",
  "version": "0.10.3",
  "identifier": "app.urinamu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/desktop-licenses.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UriNamu",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "Deine Familie. Eure Geschichte.",
    "longDescription": "Lokaler Stammbaum mit Fotos, mehreren Ansichten und verschlüsselten Familiendateien.",
    "resources": {
      "../LICENSE.md": "licenses/LICENSE.md",
      "../NOTICE": "licenses/NOTICE",
      "licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "zlib"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
